# Build artifacts. Binaries and packages never get committed; releases ship
# from CI, and `termcade dev build` writes into <game>/build/.
/bin/
/dist/
games/*/build/
*.tcade
# …except the starter pack, embedded in the Rust binary. These committed
# content assets come from termcade-games; ABI-v1 packages remain compatible.
!internal/starter/packs/*.tcade
game.wasm

.artifacts/
__pycache__/
/.ci-tools/

/target/
/internal/plugin/testdata/*/target/
